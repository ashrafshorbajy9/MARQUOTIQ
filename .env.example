# Configure these in Vercel Project Settings. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=scrypt$SALT$HASH
SESSION_SECRET=replace-with-at-least-32-random-characters
AWS_ENDPOINT_URL_S3=https://your-neon-s3-endpoint
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-key
AWS_REGION=us-east-2
MEDIA_BUCKET=marquotiq-projects
