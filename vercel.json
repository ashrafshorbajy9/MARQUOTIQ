{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/page.js": { "includeFiles": "views/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page?view=home" },
    { "source": "/admin", "destination": "/api/page?view=admin" },
    { "source": "/work/:slug", "destination": "/api/page?view=work&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/src/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
